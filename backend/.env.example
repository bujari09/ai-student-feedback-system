# Copy this file to .env and adjust the values. Never commit .env.
# No credentials go here: locally the app uses `gcloud auth application-default login`,
# on the VM it uses the attached service account (Application Default Credentials).

APP_ENV=development
LOG_LEVEL=INFO

# Google Cloud
GCP_PROJECT_ID=student-feedback-system-ai
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=feedback

# NLP: Cloud Natural Language API for these languages, Gemini (Vertex AI) for the rest
NL_SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh,zh-Hant
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LOCATION=global

# Sentiment score (-1..1) thresholds for positive / negative labels
SENTIMENT_POSITIVE_THRESHOLD=0.25
SENTIMENT_NEGATIVE_THRESHOLD=-0.25

# Comma-separated list of allowed frontend origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
